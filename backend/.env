# Security Configuration
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=vehicle_tracking.db

# CORS Configuration (Frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# Video Configuration
VIDEO_DIR=src/data/raw_videos

# ML Model Configuration
DETECTION_CONFIDENCE=0.3
PLATE_RECOGNITION_CONFIDENCE=0.2
TEMPORAL_WINDOW=10
IOU_THRESHOLD=0.5

# Tracking Configuration
VEHICLE_MATCH_TIME_WINDOW=5

# LPR Improvements for Indian Plates
INDIAN_PLATE_FORMAT_VALIDATION=true
PLATE_AGGREGATION_WINDOW=15
CHARACTER_CONFUSION_CORRECTION=true
PLATE_VALIDATION_MIN_SCORE=0.7
STRICT_PLATE_VALIDATION=false
